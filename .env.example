# Salin file ini ke .env dan isi nilainya
# Jangan pernah commit file .env ke git

# Kunci rahasia Flask untuk signing session cookie
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter

# Salt untuk hashing NPM di blockchain (jaga kerahasiaannya)
SECRET_SALT=ganti-dengan-string-acak-berbeda-dari-SECRET_KEY

# Password login admin KPU (digunakan untuk HTTP Basic Auth)
ADMIN_PASSWORD=password-kpu-yang-kuat

# --- Verifikasi KRS via QR ---
# Domain yang diizinkan untuk mengunduh KRS asli (pisahkan dengan koma).
# Proteksi SSRF: hanya URL HTTPS ke domain ini yang akan diunduh.
KRS_ALLOWED_DOMAINS=gunadarma.ac.id
# Batas waktu unduh KRS asli (detik).
KRS_DOWNLOAD_TIMEOUT=10
# Batas ukuran berkas unduhan (MB).
KRS_MAX_DOWNLOAD_MB=10
# Opsional — folder KRS lokal sebagai fallback bila unduh live gagal
# (untuk pengujian/demo offline). Kosongkan di produksi.
# KRS_LOCAL_FALLBACK_DIR=FILE/SEMUA_KRS_KUMPUL
